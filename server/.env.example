# PostgreSQL connection string (Neon).
# Neon dashboard → Connection details → copy the pooled connection string,
# keeping ?sslmode=require at the end.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional runtime tuning
# PORT=4000
# PG_POOL_MAX=5

# Optional: comma-separated origins allowed to call the API.
# Defaults to any origin (fine for the demo). Set this to your Vercel URL in production.
# CORS_ORIGIN=https://your-app.vercel.app

# Local Postgres alternative (after `docker compose up -d`):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/rove
